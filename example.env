# ==============================================================================
# КОНФИГУРАЦИЯ TELEGRAM БОТА: ТРАНСКРИБАЦИЯ ГОЛОСОВЫХ И ВИДЕОСООБЩЕНИЙ
# ==============================================================================
#
# Скопируйте этот файл в .env и настройте под ваши нужды:
# cp example.env .env
#
# ОБЯЗАТЕЛЬНАЯ НАСТРОЙКА:
# - BOT_TOKEN: токен от @BotFather
#

# ==============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ БОТА
# ==============================================================================

# Токен Telegram бота (ОБЯЗАТЕЛЬНО!)
BOT_TOKEN=

# ID администраторов бота (через запятую). Свой ID: @userinfobot
# Нужны только для команды /status.
ADMIN_USER_IDS=

# ==============================================================================
# ПУТИ К ФАЙЛАМ И ДИРЕКТОРИЯМ
# ==============================================================================

# Директория для временных аудиофайлов
AUDIO_TEMP_DIR=./temp_audio

# Корневая директория моделей (whisper, torch_hub)
MODELS_DIR=./models

# ==============================================================================
# НАСТРОЙКИ ТРАНСКРИБАЦИИ (WHISPER)
# ==============================================================================

# Модель Whisper. Принимает три вида значений:
#   1) размер: tiny, base, small, medium, large-v3, large-v3-turbo
#   2) полный repo-id HuggingFace, например Systran/faster-whisper-large-v3
#   3) путь к локальной CTranslate2-папке (внутри должен быть model.bin)
#
# large-v3-turbo (~1.6 GB) — вдвое быстрее large-v3 при том же WER
#
# У Systran нет официальной turbo-сборки, поэтому для large-v3-turbo
# автоматически подставляется deepdml/faster-whisper-large-v3-turbo-ct2.
WHISPER_MODEL=large-v3-turbo

# Faster-Whisper (CTranslate2) — в разы быстрее оригинального whisper на CPU
USE_FASTER_WHISPER=true

# Устройство для Whisper: cpu или cuda
WHISPER_DEVICE=cpu

# Точность вычислений. CPU: int8 (быстро), int8_float32, float32 (точнее, медленно).
# CUDA: float16, int8_float16. По умолчанию int8 на CPU и float16 на CUDA.
# WHISPER_COMPUTE_TYPE=int8

# Язык транскрибации (ru, en, auto...)
TRANSCRIPTION_LANGUAGE=ru

# Автоматическое восстановление пунктуации (silero_te + initial_prompt)
ADD_PUNCTUATION=true

# Beam size для whisper (больше = точнее, медленнее)
WHISPER_BEAM_SIZE=5

# Число потоков torch для silero_te (восстановление пунктуации)
PUNCTUATION_THREADS=4

# Начальная подсказка — задаёт стиль вывода (с пунктуацией).
# WHISPER_INITIAL_PROMPT="Привет, как дела? Сегодня хорошая погода..."

# ==============================================================================
# ПЛАНИРОВАНИЕ И ОБСЛУЖИВАНИЕ
# ==============================================================================

# Таймзона для планировщика задач
TIME_ZONE=Europe/Moscow

# Как часто удалять старые временные аудиофайлы (в часах)
CLEANUP_INTERVAL=24
